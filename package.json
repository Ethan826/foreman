{
  "name": "foreman",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && bun run lint && bun run prose",
    "prose": "sh tools/prose/check.sh",
    "lint": "eslint .",
    "diagram": "bun -e 'import { renderOnion } from \"./docs/diagrams/onion.ts\"; await Bun.write(\"docs/diagrams/onion.svg\", renderOnion())'",
    "test": "bun --bun vitest run",
    "docs": "typedoc"
  },
  "dependencies": {
    "effect": "4.1.4"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.4",
    "@eslint/js": "9.39.2",
    "eslint": "9.39.2",
    "eslint-plugin-functional": "9.0.4",
    "typedoc": "0.28.20",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vitest": "5.1.0"
  }
}
