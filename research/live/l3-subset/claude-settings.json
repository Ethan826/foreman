{
  "permissions": {
    "defaultMode": "dontAsk",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read(/@WORKTREE@/**)",
      "Edit(/@WORKTREE@/**)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(sh check.sh)"
    ],
    "deny": [
      "Edit(/@WORKTREE@/.git)",
      "Edit(/@WORKTREE@/**/CLAUDE.md)",
      "Edit(/@WORKTREE@/**/CLAUDE.local.md)",
      "Edit(/@WORKTREE@/**/AGENTS.md)",
      "Edit(/@WORKTREE@/**/.claude/**)",
      "Edit(/@WORKTREE@/**/.codex/**)",
      "Edit(/@WORKTREE@/**/.mcp.json)",
      "Edit(/@WORKTREE@/**/.gitattributes)",
      "Edit(/@WORKTREE@/**/.gitmodules)",
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git config)",
      "Bash(git config *)",
      "Bash(curl)",
      "Bash(curl *)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "denyWrite": [
        "@WORKTREE@/.git",
        "@WORKTREE@/CLAUDE.md",
        "@WORKTREE@/CLAUDE.local.md",
        "@WORKTREE@/AGENTS.md",
        "@WORKTREE@/.claude",
        "@WORKTREE@/.codex",
        "@WORKTREE@/.mcp.json",
        "@WORKTREE@/.gitattributes",
        "@WORKTREE@/.gitmodules"
      ]
    },
    "network": {
      "allowedDomains": []
    }
  },
  "autoMemoryEnabled": false
}
